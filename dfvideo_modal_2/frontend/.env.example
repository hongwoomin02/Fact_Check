# [영상 탐지] Vite 개발 서버 프록시 대상 Modal HTTPS 주소
MODAL_VIDEO_API_ORIGIN=https://goyeas52--dfvideo-web.us-east.modal.run
VITE_VIDEO_API_BASE_URL=/api/video

# [텍스트 팩트체크] 개발 서버 프록시 대상 텍스트 백엔드 주소 (기본 로컬 8001번 포트)
TEXT_API_ORIGIN=http://localhost:8001
VITE_TEXT_API_BASE_URL=/api/text

# [시연용 딥페이크 생성] FaceFusion GPU 서버 주소 (11월 배포 전까지는 MOCK 모드 사용)
# Vercel 환경 배포 시 NEXT_PUBLIC_* 또는 VITE_* 접두사 모두 호환
VITE_GEN_MOCK=true
VITE_GEN_API_BASE=
VITE_DETECT_URL=/video

# Next.js / Vercel 호환 명칭
NEXT_PUBLIC_GEN_MOCK=true
NEXT_PUBLIC_GEN_API_BASE=
NEXT_PUBLIC_DETECT_URL=/video
